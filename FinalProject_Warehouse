public abstract class FinalProject_Warehouse {
	String warehouseName;
	int warehouseVolume;
	
	public FinalProject_Warehouse() {
		warehouseName = "";
		warehouseVolume = 0;
	}
	
	public FinalProject_Warehouse(String n, int v) {
		warehouseName = n;
		warehouseVolume = v;
	}
	
	public String getWarehouseName() {
		return warehouseName;
	}
	
	public int getWarehouseVolume() {
		return warehouseVolume;
	}
	
}

